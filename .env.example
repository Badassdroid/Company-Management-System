# Copy this file to .env and fill in values from your Supabase project settings.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Use the publishable key for new projects, or the anon key for legacy projects.
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Frontend URL used as the redirect target for employee account invitations.
FRONTEND_URL=https://YOUR-VERCEL-DOMAIN

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
